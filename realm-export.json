{
  "realm": "hospigrow",
  "enabled": true,
  "displayName": "Hospigrow",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "loginTheme": "keycloak",
  "registrationAllowed": false,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and passwordHistory(5)",
  "roles": {
    "realm": [
      { "name": "doctor", "description": "Licensed clinician with full clinical access" },
      { "name": "nurse", "description": "Nursing staff" },
      { "name": "lab_technician", "description": "Laboratory staff" },
      { "name": "pharmacist", "description": "Pharmacy staff" },
      { "name": "radiologist", "description": "Radiology staff" },
      { "name": "hospital_admin", "description": "Hospital administrator" },
      { "name": "accountant", "description": "Finance staff" },
      { "name": "hr_manager", "description": "HR manager" },
      { "name": "receptionist", "description": "Front-desk staff" },
      { "name": "patient", "description": "Patient self-service" },
      { "name": "system_admin", "description": "System administrator (root)" }
    ]
  },
  "clients": [
    {
      "clientId": "middleware",
      "name": "Hospigrow Middleware API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "hospital-app",
      "name": "Hospital (Clinical) App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "staff-app",
      "name": "Staff (Operations) App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      }
    },
    {
      "clientId": "patient-app",
      "name": "Patient App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3002/*"
      }
    },
    {
      "clientId": "erpnext",
      "name": "ERPNext",
      "enabled": true,
      "publicClient": false,
      "secret": "REPLACE_ME_AFTER_IMPORT",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://staff.hospigrow.com/*"],
      "webOrigins": ["+"]
    }
  ],
  "users": [
    {
      "username": "dr.demo",
      "email": "dr.demo@hospigrow.com",
      "firstName": "Demo",
      "lastName": "Doctor",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "ChangeMe123!", "temporary": true }
      ],
      "realmRoles": ["doctor"]
    },
    {
      "username": "admin.demo",
      "email": "admin.demo@hospigrow.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "ChangeMe123!", "temporary": true }
      ],
      "realmRoles": ["hospital_admin"]
    },
    {
      "username": "patient.demo",
      "email": "patient.demo@hospigrow.com",
      "firstName": "Demo",
      "lastName": "Patient",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "ChangeMe123!", "temporary": true }
      ],
      "realmRoles": ["patient"]
    }
  ]
}
